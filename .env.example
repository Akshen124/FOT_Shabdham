# ==============================================================================
# Shabdham Voice AI - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual credentials.
# DO NOT commit .env or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# API Keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) Configuration
# Primary: Groq Cloud TTS (canopylabs/orpheus-v1-english)
# Fallback: Deepgram Cloud TTS (aura-asteria-en)
# ------------------------------------------------------------------------------
TTS_PROVIDER=auto
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
DEEPGRAM_TTS_VOICE=aura-asteria-en
TTS_AUDIO_FORMAT=wav
TTS_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) Configuration
# ------------------------------------------------------------------------------
STT_PRIMARY_PROVIDER=gemini_live
STT_FALLBACK_PROVIDER=groq_whisper
STT_TIMEOUT_SECONDS=45.0
STT_MAX_CONCURRENT_REQUESTS=4

# ------------------------------------------------------------------------------
# Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=shabdham_docs

# ------------------------------------------------------------------------------
# Redis Memory & Caching
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MEMORY_TTL=3600

# ------------------------------------------------------------------------------
# Server / Frontend Integration
# ------------------------------------------------------------------------------
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000
